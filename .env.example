# CrisisPulse AI · Nagpur Live Emergency Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate.

# ==============================================================================
# APPLICATION RUNTIME
# ==============================================================================
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
DATABASE_PATH=data/crisispulse.db

# ==============================================================================
# OPERATIONAL GEOGRAPHY (NAGPUR DISTRICT & NMC URBAN AREA)
# ==============================================================================
# Nagpur Zero Mile Stone centroid: 21.1458° N, 79.0882° E
MONITORED_LOCATION_NAME=Nagpur District, Maharashtra, India
MONITORED_LATITUDE=21.1458
MONITORED_LONGITUDE=79.0882
DEFAULT_RADIUS_KM=35.0

# Administrative Scope
NAGPUR_DISTRICT_BBOX=[20.58,78.25,21.75,79.67]
NMC_URBAN_BBOX=[21.06,79.00,21.23,79.18]

# ==============================================================================
# xAI (GROK) GROUNDED EXPLAINABILITY ENGINE
# ==============================================================================
# Official API endpoint: https://api.x.ai/v1/chat/completions
# If left blank or invalid, system automatically runs deterministic grounded synthesis.
XAI_API_KEY=
XAI_MODEL=grok-2-1212
XAI_TEMPERATURE=0.1
XAI_TIMEOUT_SECONDS=10.0
XAI_CACHE_TTL_SECONDS=180

# ==============================================================================
# EXTERNAL DATA INGESTION CONNECTORS & CREDENTIALS
# ==============================================================================

# 1. India Meteorological Department (IMD) / RMC Nagpur
# Official API Reference: https://api.imd.gov.in/public/api_reference.html
# District Code for Nagpur: 106
IMD_API_KEY=
IMD_DISTRICT_CODE=106
IMD_POLL_INTERVAL=300

# 2. Open-Meteo High-Resolution Nagpur Telemetry & Forecasts
# Supplemental weather telemetry and deterministic forecast models
OPEN_METEO_POLL_INTERVAL=60

# 3. NMC Stormwater Drainage & IoT Waterlogging Sensor Network
# Endpoint for municipal level sensors and pumping station telemetry
# If blank, provider evaluates chronic hotspot thresholds deterministically.
NMC_DRAINAGE_IOT_URL=
DRAINAGE_POLL_INTERVAL=120

# 4. Nagpur Emergency Healthcare & Hospital Bed Availability
# Tracks GMCH Trauma Center, Mayo Hospital, AIIMS Nagpur surge capacity
# Strictly aggregated capacity metrics; no patient identifiable data.
NAGPUR_HEALTH_API_URL=
HOSPITAL_POLL_INTERVAL=180

# 5. Nagpur Traffic Police & Smart City Transit Congestion Feeds
# Monitors Wardha Rd, Central Ave, underpass closures & ambulance routing
NAGPUR_TRAFFIC_API_URL=
TRAFFIC_POLL_INTERVAL=120

# 6. NASA FIRMS (Active Fire / Thermal Anomaly Satellite VIIRS)
# Free MAP_KEY registration: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If unconfigured, adapter serves verified reference historical fire records.
FIRMS_MAP_KEY=
NASA_FIRMS_POLL_INTERVAL=300

# 7. Global Feeds (USGS Earthquake & GDACS)
# Filtered strictly with Nagpur spatial filter (excludes non-impacting global events)
USGS_EARTHQUAKE_POLL_INTERVAL=60
GDACS_POLL_INTERVAL=300

# ==============================================================================
# DECISION ENGINE & CAUTIOUS ESCALATION GATES
# ==============================================================================
# Minimum probability threshold required before escalating to ALERT
ALERT_CASCADE_THRESHOLD=0.40
# Minimum probability threshold required before escalating to ESCALATE
ESCALATION_CASCADE_THRESHOLD=0.70
# Minimum independent source corroboration count required for ESCALATE
MIN_CORROBORATING_SOURCES_FOR_ESCALATE=2
